-- Career journey page CMS (singleton)
-- Maps to: app/journey/page.tsx
-- Job cards → careers table

CREATE TABLE public.journey (
  id integer PRIMARY KEY DEFAULT 1 CHECK (id = 1),
  header_headline text NOT NULL DEFAULT '',
  header_sub text NOT NULL DEFAULT '',
  header_bg_image text NOT NULL DEFAULT '',
  header_bg_alt text NOT NULL DEFAULT '',
  intro_headline text NOT NULL DEFAULT '',
  intro_sub text NOT NULL DEFAULT '',
  why_headline text NOT NULL DEFAULT '',
  why_strength_1_headline text NOT NULL DEFAULT '',
  why_strength_1_sub text NOT NULL DEFAULT '',
  why_strength_2_headline text NOT NULL DEFAULT '',
  why_strength_2_sub text NOT NULL DEFAULT '',
  why_strength_3_headline text NOT NULL DEFAULT '',
  why_strength_3_sub text NOT NULL DEFAULT '',
  value_chain_image text NOT NULL DEFAULT '',
  value_chain_image_alt text NOT NULL DEFAULT '',
  value_chain_headline text NOT NULL DEFAULT '',
  value_chain_sub text NOT NULL DEFAULT '',
  value_chain_stage_1_headline text NOT NULL DEFAULT '',
  value_chain_stage_1_sub text NOT NULL DEFAULT '',
  value_chain_stage_2_headline text NOT NULL DEFAULT '',
  value_chain_stage_2_sub text NOT NULL DEFAULT '',
  value_chain_stage_3_headline text NOT NULL DEFAULT '',
  value_chain_stage_3_sub text NOT NULL DEFAULT '',
  value_chain_stage_4_headline text NOT NULL DEFAULT '',
  value_chain_stage_4_sub text NOT NULL DEFAULT '',
  value_chain_stage_5_headline text NOT NULL DEFAULT '',
  value_chain_stage_5_sub text NOT NULL DEFAULT '',
  value_chain_stage_6_headline text NOT NULL DEFAULT '',
  value_chain_stage_6_sub text NOT NULL DEFAULT '',
  career_paths_headline text NOT NULL DEFAULT '',
  career_paths_sub text NOT NULL DEFAULT '',
  career_path_1_headline text NOT NULL DEFAULT '',
  career_path_1_sub text NOT NULL DEFAULT '',
  career_path_2_headline text NOT NULL DEFAULT '',
  career_path_2_sub text NOT NULL DEFAULT '',
  career_path_3_headline text NOT NULL DEFAULT '',
  career_path_3_sub text NOT NULL DEFAULT '',
  career_path_4_headline text NOT NULL DEFAULT '',
  career_path_4_sub text NOT NULL DEFAULT '',
  open_positions_headline text NOT NULL DEFAULT '',
  open_positions_sub text NOT NULL DEFAULT '',
  talent_network_headline text NOT NULL DEFAULT '',
  talent_network_sub text NOT NULL DEFAULT '',
  talent_network_submit_label text NOT NULL DEFAULT '',
  talent_network_success_title text NOT NULL DEFAULT '',
  talent_network_success_message text NOT NULL DEFAULT '',
  is_published boolean NOT NULL DEFAULT true,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);

ALTER TABLE public.journey ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public can read published journey" ON public.journey
  FOR SELECT TO anon, authenticated USING (is_published = true);
CREATE POLICY "Authenticated users can manage journey" ON public.journey
  FOR ALL TO authenticated USING (true) WITH CHECK (true);

COMMENT ON COLUMN public.journey.intro_headline IS 'Rich text (HTML). Sanitize with sanitize-html.';
COMMENT ON COLUMN public.journey.intro_sub IS 'Rich text (HTML). Sanitize with sanitize-html.';

