  hotline_protection_title text NOT NULL DEFAULT '',
  hotline_protection_intro text NOT NULL DEFAULT '',
  hotline_protection_1_title text NOT NULL DEFAULT '',
  hotline_protection_1_sub text NOT NULL DEFAULT '',
  hotline_protection_2_title text NOT NULL DEFAULT '',
  hotline_protection_2_sub text NOT NULL DEFAULT '',
  hotline_guidelines_title text NOT NULL DEFAULT '',
  hotline_guidelines_intro text NOT NULL DEFAULT '',
  hotline_guideline_1 text NOT NULL DEFAULT '',
  hotline_guideline_2 text NOT NULL DEFAULT '',
  hotline_guideline_3 text NOT NULL DEFAULT '',
  hotline_guideline_4 text NOT NULL DEFAULT '',
  hotline_guideline_5 text NOT NULL DEFAULT '',
  hotline_guideline_6 text NOT NULL DEFAULT '',
  hotline_guidelines_note text NOT NULL DEFAULT '',
  hotline_form_title text NOT NULL DEFAULT '',
  hotline_form_intro text NOT NULL DEFAULT '',
  hotline_success_title text NOT NULL DEFAULT '',
  hotline_success_message text NOT NULL DEFAULT '',
  is_published boolean NOT NULL DEFAULT true,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);

ALTER TABLE public.ethics ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public can read published ethics" ON public.ethics
  FOR SELECT TO anon, authenticated USING (is_published = true);
CREATE POLICY "Authenticated users can manage ethics" ON public.ethics
  FOR ALL TO authenticated USING (true) WITH CHECK (true);

COMMENT ON COLUMN public.ethics.intro_headline IS 'Rich text (HTML). Sanitize with sanitize-html.';
COMMENT ON COLUMN public.ethics.intro_sub IS 'Rich text (HTML). Sanitize with sanitize-html.';
COMMENT ON COLUMN public.ethics.leadership_quote IS 'Rich text (HTML). Sanitize with sanitize-html.';

