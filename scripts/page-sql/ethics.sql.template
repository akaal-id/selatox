  leadership_quote text NOT NULL DEFAULT '',
  hotline_title text NOT NULL DEFAULT '',
  hotline_intro text NOT NULL DEFAULT '',
  hotline_contact_email text NOT NULL DEFAULT '',
  hotline_reportable_title text NOT NULL DEFAULT '',
  hotline_reportable_1_title text NOT NULL DEFAULT '',
