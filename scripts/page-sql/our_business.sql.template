  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);

ALTER TABLE public.our_business ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public can read published our_business" ON public.our_business
  FOR SELECT TO anon, authenticated USING (is_published = true);
CREATE POLICY "Authenticated users can manage our_business" ON public.our_business
  FOR ALL TO authenticated USING (true) WITH CHECK (true);

COMMENT ON COLUMN public.our_business.partnerships_closing_sub IS 'Rich text (HTML). Sanitize with sanitize-html.';

