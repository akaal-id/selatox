-- Maps to: app/our-business/manufacturing/page.tsx

CREATE TABLE public.manufacturing (
  id integer PRIMARY KEY DEFAULT 1 CHECK (id = 1),
  header_headline text NOT NULL DEFAULT '',
  header_sub text NOT NULL DEFAULT '',
  header_lead text NOT NULL DEFAULT '',
  scale_headline text NOT NULL DEFAULT '',
  metric_1_label text NOT NULL DEFAULT '',
  metric_1_value text NOT NULL DEFAULT '',
  metric_1_detail text NOT NULL DEFAULT '',
  metric_2_label text NOT NULL DEFAULT '',
  metric_2_value text NOT NULL DEFAULT '',
  metric_2_detail text NOT NULL DEFAULT '',
  metric_3_label text NOT NULL DEFAULT '',
  metric_3_value text NOT NULL DEFAULT '',
  metric_3_detail text NOT NULL DEFAULT '',
  metric_4_label text NOT NULL DEFAULT '',
  metric_4_value text NOT NULL DEFAULT '',
  metric_4_detail text NOT NULL DEFAULT '',
  process_image_src text NOT NULL DEFAULT '',
  process_image_alt text NOT NULL DEFAULT '',
  process_headline text NOT NULL DEFAULT '',
  process_sub text NOT NULL DEFAULT '',
  quality_headline text NOT NULL DEFAULT '',
  quality_sub text NOT NULL DEFAULT '',
  quality_point_1 text NOT NULL DEFAULT '',
  quality_point_2 text NOT NULL DEFAULT '',
  quality_point_3 text NOT NULL DEFAULT '',
  quality_point_4 text NOT NULL DEFAULT '',
  workplace_headline text NOT NULL DEFAULT '',
  workplace_sub text NOT NULL DEFAULT '',
  workplace_image_src text NOT NULL DEFAULT '',
  workplace_image_alt text NOT NULL DEFAULT '',
  is_published boolean NOT NULL DEFAULT true,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);

ALTER TABLE public.manufacturing ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public can read published manufacturing" ON public.manufacturing
  FOR SELECT TO anon, authenticated USING (is_published = true);
CREATE POLICY "Authenticated users can manage manufacturing" ON public.manufacturing
  FOR ALL TO authenticated USING (true) WITH CHECK (true);

